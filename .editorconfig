root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = tab
indent_size = 3
trim_trailing_whitespace = true
insert_final_newline = true
quote_type = single

[*.{json,html,css,scss}]
quote_type = double

[*.{yml,yaml}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 3

[*.md]
trim_trailing_whitespace = false
